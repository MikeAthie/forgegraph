# =========================================================

# ForgeGraph Environment Configuration (.env.example)

# =========================================================

# Copy this file to `.env` and fill in required values.

# DO NOT commit `.env` to version control.

# =========================================================

# CORE SECRETS (REQUIRED)

# =========================================================

# Django secret key.
# Generate for real deployments: openssl rand -base64 64
SECRET_KEY=django-insecure-example-only-replace-before-deploying-64-byte-placeholder

# Encryption key (Fernet)
# Generate for real deployments:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=31w_1yyrCRlD_5Uyp9iofvy68W9T1ty9W81BbBlkbWI=

# Engine <-> Backend authentication.
# Generate for real deployments: openssl rand -hex 32
ENGINE_CALLBACK_SECRET=example-engine-callback-secret-replace-before-deploying

# Engine HTTP runtime-tool authentication.
# Must be distinct from ENGINE_CALLBACK_SECRET.
# Generate for real deployments: openssl rand -hex 32
RUNTIME_TOOL_SECRET=example-runtime-tool-secret-replace-before-deploying

# Database credentials

DB_NAME=forgegraph
DB_USER=forgegraph
DB_PASSWORD=forgegraph_secret
DB_HOST=postgres
DB_PORT=5432

# =========================================================

# INFRASTRUCTURE

# =========================================================

# Redis (required for runtime intents + snapshots)

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_ADDR=redis:6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_SENTINEL_ADDRS=
REDIS_SENTINEL_MASTER_NAME=
REDIS_SENTINEL_USERNAME=
REDIS_SENTINEL_PASSWORD=
REDIS_SOCKET_TIMEOUT_MS=
REDIS_SOCKET_CONNECT_TIMEOUT_MS=

# Managed Kafka communication transport (optional; backend database remains authoritative)
COMMUNICATION_KAFKA_ENABLED=false
COMMUNICATION_KAFKA_BOOTSTRAP_SERVERS=
COMMUNICATION_KAFKA_TOPIC=forgegraph.communication.events.v1
COMMUNICATION_KAFKA_CLIENT_ID=forgegraph-communication-outbox
COMMUNICATION_KAFKA_CONSUMER_GROUP=forgegraph-communication-events
COMMUNICATION_KAFKA_SECURITY_PROTOCOL=
COMMUNICATION_KAFKA_SASL_MECHANISM=
COMMUNICATION_KAFKA_SASL_USERNAME=
COMMUNICATION_KAFKA_SASL_PASSWORD=
COMMUNICATION_KAFKA_FLUSH_TIMEOUT_SECONDS=5
COMMUNICATION_KAFKA_PRODUCE_POLL_TIMEOUT_SECONDS=1
COMMUNICATION_KAFKA_DELIVERY_TIMEOUT_MS=30000
COMMUNICATION_KAFKA_REQUEST_TIMEOUT_MS=10000
COMMUNICATION_KAFKA_RETRIES=5
COMMUNICATION_KAFKA_RETRY_BACKOFF_MS=250
COMMUNICATION_KAFKA_LINGER_MS=5
COMMUNICATION_KAFKA_COMPRESSION_TYPE=lz4
COMMUNICATION_KAFKA_STATISTICS_INTERVAL_MS=0
COMMUNICATION_KAFKA_MAX_PAYLOAD_BYTES=65536
COMMUNICATION_KAFKA_AUTO_OFFSET_RESET=earliest
COMMUNICATION_KAFKA_ISOLATION_LEVEL=read_committed
COMMUNICATION_KAFKA_SESSION_TIMEOUT_MS=45000
COMMUNICATION_KAFKA_MAX_POLL_INTERVAL_MS=300000
COMMUNICATION_KAFKA_METADATA_TIMEOUT_SECONDS=5
COMMUNICATION_KAFKA_OUTBOX_BACKLOG_READY_THRESHOLD=1000
READINESS_REQUIRE_COMMUNICATION_KAFKA=false
COMMUNICATION_ROUTING_FROM_KAFKA_ENABLED=false
REQUEST_ROUTER_FROM_KAFKA_ENABLED=false

# WorkWhiteboard project board transport (optional; DB remains authoritative)
WHITEBOARD_BOARD_KAFKA_ENABLED=false
WHITEBOARD_BOARD_KAFKA_BOOTSTRAP_SERVERS=
WHITEBOARD_BOARD_KAFKA_TOPIC=forgegraph.whiteboard.board.events.v1
WHITEBOARD_BOARD_KAFKA_CLIENT_ID=forgegraph-whiteboard-board-outbox
WHITEBOARD_BOARD_KAFKA_CONSUMER_GROUP=forgegraph-whiteboard-board-events
WHITEBOARD_BOARD_KAFKA_FLUSH_TIMEOUT_SECONDS=5
WHITEBOARD_BOARD_KAFKA_DELIVERY_TIMEOUT_MS=30000
WHITEBOARD_BOARD_KAFKA_REQUEST_TIMEOUT_MS=10000
WHITEBOARD_BOARD_KAFKA_RETRIES=5
WHITEBOARD_BOARD_KAFKA_RETRY_BACKOFF_MS=250
WHITEBOARD_BOARD_KAFKA_LINGER_MS=5
WHITEBOARD_BOARD_KAFKA_COMPRESSION_TYPE=lz4
WHITEBOARD_BOARD_KAFKA_MAX_PAYLOAD_BYTES=65536
WHITEBOARD_BOARD_KAFKA_AUTO_OFFSET_RESET=earliest
WHITEBOARD_BOARD_KAFKA_ISOLATION_LEVEL=read_committed

# Control plane + frontend

CONTROL_PLANE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# =========================================================

# ENVIRONMENT

# =========================================================

# Environment mode: development | staging | production

ENVIRONMENT=development

# Debug mode (false in production)

DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1,testserver,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000


# =========================================================

# CORS / SECURITY

# =========================================================

# Security flags (set to true in production)

SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_SECURE=false
# Local/docker HTTP smoke tests may keep transport insecure only when explicit.
# Production must leave this unset/false and enable the secure flags above.
FORGEGRAPH_ALLOW_INSECURE_TRANSPORT=true

# =========================================================

# RUNTIME SETTINGS

# =========================================================

# Run liveness timeout (seconds)

RUN_LIVENESS_TIMEOUT_SECONDS=300
RUN_ENGINE_STALLED_TIMEOUT_SECONDS=300
RUN_QUEUE_ENABLED=false

# Operating model packs are backend-owned configuration. Docker mounts them at /operating_model_packs.
OPERATING_MODEL_PACKS_DIR=/operating_model_packs
REQUIRED_OPERATING_MODEL_PACKS=digital_marketing_pro
VALIDATE_REQUIRED_OPERATING_MODEL_PACKS_ON_STARTUP=true

# =========================================================

# FEATURE FLAGS

# =========================================================

FF_OS_SHELL=true
FF_AGENT_REGISTRY=true
FF_TASK_PROJECTIONS=true
FF_DECISION_CENTER=true
FF_ACCOUNTING_AGGREGATES=true
FF_PUBLIC_API_ALIASES=true

# Memory system

FF_CURATED_MEMORY_ENABLED=true
FF_CURATED_MEMORY_VECTOR_INDEXING=true
CURATED_MEMORY_EMBEDDING_MODEL=text-embedding-ada-002

# =========================================================

# OPTIONAL ADMIN BOOTSTRAP

# =========================================================

DJANGO_SUPERUSER_CREATE=false
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# =========================================================

# ENGINE CONFIGURATION

# =========================================================

# Execution model

ENGINE_RUN_STATE_MODE=control-plane-http
ENGINE_RUNTIME_WRITE_MODE=pause-intents
ENGINE_RUNTIME_INTENT_STREAM=forgegraph:runtime:intents
ENGINE_RUNTIME_INTENT_RETRY_INITIAL_BACKOFF_MS=100
ENGINE_RUNTIME_INTENT_RETRY_MAX_BACKOFF_MS=2000
ENGINE_RUNTIME_INTENT_RETRY_MAX_ELAPSED_MS=20000
ENGINE_RUNTIME_INTENT_STREAM_MAXLEN=0

# Engine external dependencies

OPENAI_API_KEY=
TOOL_MANIFEST_DIR=

# =========================================================

# OAUTH (OPTIONAL)

# =========================================================

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/oauth/callback

# NOTES

# =========================================================

# - Use `.env` locally, and a secrets manager in production

# - Never commit real secrets

# - Rotate secrets using multi-value fields where supported

# - Redis is required for runtime execution (intents + snapshots)

# =========================================================
