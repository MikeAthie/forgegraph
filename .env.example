# =========================================================

# ForgeGraph Environment Configuration (.env.example)

# =========================================================

# Copy this file to `.env` and fill in required values.

# DO NOT commit `.env` to version control.

# =========================================================

# 🔐 CORE SECRETS (REQUIRED)

# =========================================================

# Django secret key (64+ random bytes)

# Generate: openssl rand -base64 64

SECRET_KEYS=

# Encryption key (Fernet)

# Generate:

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

ENCRYPTION_KEY=

# Engine ↔ Backend authentication (supports rotation)

# Generate: openssl rand -hex 32

# Multiple values allowed (comma-separated)

ENGINE_CALLBACK_SECRETS=

# Database credentials

DB_NAME=forgegraph
DB_USER=forgegraph
DB_PASSWORD=

# =========================================================

# 🧱 INFRASTRUCTURE

# =========================================================

# Redis (required for runtime intents + snapshots)

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_ADDR=redis:6379

# Control plane + frontend

CONTROL_PLANE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# =========================================================

# ⚙️ ENVIRONMENT

# =========================================================

# Environment mode: development | staging | production

ENVIRONMENT=development

# Debug mode (false in production)

DEBUG=false

# Allowed hosts (comma-separated)

ALLOWED_HOSTS=localhost,127.0.0.1

# =========================================================

# 🌐 CORS / SECURITY

# =========================================================

CORS_ALLOWED_ORIGINS=[http://localhost:3000,http://127.0.0.1:3000](http://localhost:3000,http://127.0.0.1:3000)
CSRF_TRUSTED_ORIGINS=[http://localhost:3000,http://127.0.0.1:3000](http://localhost:3000,http://127.0.0.1:3000)

# Security flags (set to true in production)

SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_SECURE=false

# =========================================================

# ⏱ RUNTIME SETTINGS

# =========================================================

# Run liveness timeout (seconds)

RUN_LIVENESS_TIMEOUT_SECONDS=300

# =========================================================

# 🧠 FEATURE FLAGS

# =========================================================

FF_OS_SHELL=true
FF_AGENT_REGISTRY=true
FF_TASK_PROJECTIONS=true
FF_DECISION_CENTER=true
FF_ACCOUNTING_AGGREGATES=true
FF_PUBLIC_API_ALIASES=true

# Memory system

FF_CURATED_MEMORY_ENABLED=true
FF_CURATED_MEMORY_VECTOR_INDEXING=true
CURATED_MEMORY_EMBEDDING_MODEL=text-embedding-ada-002

# =========================================================

# 👤 OPTIONAL ADMIN BOOTSTRAP

# =========================================================

DJANGO_SUPERUSER_CREATE=false
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# =========================================================

# ⚙️ ENGINE CONFIGURATION

# =========================================================

# Execution model

ENGINE_RUN_STATE_MODE=control-plane-http
ENGINE_RUNTIME_WRITE_MODE=pause-intents
ENGINE_RUNTIME_INTENT_STREAM=forgegraph:runtime:intents

# Engine external dependencies

OPENAI_API_KEY=
TOOL_MANIFEST_DIR=

# =========================================================

# 🔐 OAUTH (OPTIONAL)

# =========================================================

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/oauth/callback

# =========================================================

# 📝 NOTES

# =========================================================

# - Use `.env` locally, and a secrets manager in production

# - Never commit real secrets

# - Rotate secrets using multi-value fields where supported

# - Redis is required for runtime execution (intents + snapshots)

# =========================================================
