# Backend encryption key (required to store credentials securely)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
SECRET_KEY=
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1,testserver,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_SECURE=false
DJANGO_SUPERUSER_CREATE=false
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
FF_CURATED_MEMORY_ENABLED=true
FF_CURATED_MEMORY_VECTOR_INDEXING=true
CURATED_MEMORY_EMBEDDING_MODEL=text-embedding-ada-002

# Service-level Google OAuth app config (shared by Gmail/Google Calendar/Google Tasks/Google Drive)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/oauth/callback

# Engine tool manifests (optional override; docker compose defaults to /app/tool-manifests)
TOOL_MANIFEST_DIR=

# Engine runtime state ownership
# control-plane-http is the intended default; legacy dual-write is removed
ENGINE_RUN_STATE_MODE=control-plane-http
# Runtime write transport:
# - pause-intents: engine publishes backend-owned runtime write intents to Redis Streams
ENGINE_RUNTIME_INTENT_STREAM=forgegraph:runtime:intents
ENGINE_RUNTIME_WRITE_MODE=pause-intents
REDIS_ADDR=localhost:6379
CONTROL_PLANE_URL=http://localhost:8000
ENGINE_CALLBACK_SECRET=
RUN_LIVENESS_TIMEOUT_SECONDS=300
