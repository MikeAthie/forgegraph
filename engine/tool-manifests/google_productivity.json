{
  "tools": [
    {
      "name": "gmail_reader",
      "version": "1.0.0",
      "category": "communication",
      "description": "Fetch unread Gmail messages",
      "visibility": "public",
      "input_schema": {
        "type": "object"
      },
      "default_config": {
        "provider": "gmail",
        "max_results": 10,
        "query": "is:unread"
      },
      "execution": {
        "type": "http",
        "timeout_seconds": 30,
        "http": {
          "url": "https://gmail.googleapis.com/gmail/v1/users/me/messages?maxResults={{config.max_results}}&q={{config.query}}",
          "method": "GET",
          "headers": {
            "Accept": "application/json"
          }
        }
      },
      "side_effects": {
        "type": "read",
        "idempotent": true
      }
    },
    {
      "name": "google_calendar",
      "version": "1.0.0",
      "category": "productivity",
      "description": "List Google Calendar events",
      "visibility": "public",
      "input_schema": {
        "type": "object"
      },
      "default_config": {
        "provider": "google_calendar",
        "max_results": 10
      },
      "execution": {
        "type": "http",
        "timeout_seconds": 30,
        "http": {
          "url": "https://www.googleapis.com/calendar/v3/calendars/primary/events?singleEvents=true&orderBy=startTime&maxResults={{config.max_results}}",
          "method": "GET",
          "headers": {
            "Accept": "application/json"
          }
        }
      },
      "side_effects": {
        "type": "read",
        "idempotent": true
      }
    },
    {
      "name": "google_tasks",
      "version": "1.0.0",
      "category": "productivity",
      "description": "List tasks from Google Tasks default list",
      "visibility": "public",
      "input_schema": {
        "type": "object"
      },
      "default_config": {
        "provider": "google_tasks",
        "max_results": 20,
        "include_completed": false
      },
      "execution": {
        "type": "http",
        "timeout_seconds": 30,
        "http": {
          "url": "https://tasks.googleapis.com/tasks/v1/lists/@default/tasks?maxResults={{config.max_results}}&showCompleted={{config.include_completed}}",
          "method": "GET",
          "headers": {
            "Accept": "application/json"
          }
        }
      },
      "side_effects": {
        "type": "read",
        "idempotent": true
      }
    }
  ]
}
