# Repo-owned backend test environment.
# Loaded by backend/config/test_settings.py for local pytest and CI backend jobs.

TESTING=true
DEBUG=false
SECRET_KEY=ci-not-a-secret-for-forgegraph-tests-32-bytes-minimum
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DJANGO_SETTINGS_MODULE=config.test_settings
ENCRYPTION_KEY=31w_1yyrCRlD_5Uyp9iofvy68W9T1ty9W81BbBlkbWI=
SECURE_SSL_REDIRECT=false

DB_HOST=localhost
DB_PORT=5433
DB_NAME=forgegraph
DB_USER=forgegraph
DB_PASSWORD=forgegraph_secret

REDIS_HOST=localhost
REDIS_PORT=6379

USE_SQLITE=false
USE_IN_MEMORY_CHANNEL_LAYER=false

# Keep tests independent from connector values in the developer .env file.
EMAIL_CONNECTOR_PROVIDER=fake
EMAIL_CONNECTOR_DRY_RUN_DEFAULT=true
EMAIL_CONNECTOR_ALLOW_REAL_SEND=false
EMAIL_CONNECTOR_RECIPIENT_ALLOWLIST=
EMAIL_CONNECTOR_DEFAULT_FROM_EMAIL=
EMAIL_CONNECTOR_DEFAULT_FROM_NAME=
EMAIL_CONNECTOR_TIMEOUT_SECONDS=10
EMAIL_CONNECTOR_MAX_RECIPIENTS=50
