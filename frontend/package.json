{
  "name": "forgegraph-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "terminology:check": "node ../scripts/frontend/check-terminology-boundary.mjs",
    "lint": "next lint",
    "test": "node --max-old-space-size=4096 node_modules/jest/bin/jest.js",
    "test:related": "node --max-old-space-size=4096 node_modules/jest/bin/jest.js --findRelatedTests",
    "test:ci:fast": "node --max-old-space-size=4096 node_modules/jest/bin/jest.js --findRelatedTests --passWithNoTests",
    "test:watch": "node --max-old-space-size=4096 node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --max-old-space-size=4096 node_modules/jest/bin/jest.js --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "demo:capture": "playwright test --config=playwright.demo.config.ts",
    "all": "npm test && npm run test:e2e"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-query": "^5.100.9",
    "@types/dagre": "^0.7.53",
    "@xyflow/react": "^12.10.0",
    "axios": "^1.15.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dagre": "^0.8.5",
    "lucide-react": "^0.562.0",
    "next": "^15.5.15",
    "next-themes": "^0.4.6",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.8",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.23",
    "eslint": "8.57.1",
    "eslint-config-next": "^15.5.15",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "postcss": "^8.5.12",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "postcss": "^8.5.12"
  }
}
